<scalastyle commentFilter="enabled">
  <name>Scalastyle standard configuration</name>

  <!-- File and Line Complexity -->
  <check level="warning" class="org.scalastyle.file.FileLengthChecker" enabled="true">
    <parameters>
      <parameter name="maxFileLength"><![CDATA[800]]></parameter>
    </parameters>
  </check>
  <check level="warning" class="org.scalastyle.file.FileLineLengthChecker" enabled="true">
    <parameters>
      <parameter name="maxLineLength"><![CDATA[120]]></parameter>
      <parameter name="tabSize"><![CDATA[2]]></parameter>
    </parameters>
  </check>
  <check level="warning" class="org.scalastyle.scalar.MethodLengthChecker" enabled="true">
    <parameters>
      <parameter name="maxLength"><![CDATA[50]]></parameter>
    </parameters>
  </check>
  <check level="warning" class="org.scalastyle.scalar.CyclomaticComplexityChecker" enabled="true">
    <parameters>
      <parameter name="maximum"><![CDATA[10]]></parameter>
    </parameters>
  </check>

  <!-- Naming Conventions -->
  <check level="warning" class="org.scalastyle.scalar.ClassNamesChecker" enabled="true">
    <parameters>
      <parameter name="regex"><![CDATA[[A-Z][A-Za-z0-9]*]]></parameter>
    </parameters>
  </check>
  <check level="warning" class="org.scalastyle.scalar.ObjectNamesChecker" enabled="true">
    <parameters>
      <parameter name="regex"><![CDATA[[A-Z][A-Za-z0-9]*]]></parameter>
    </parameters>
  </check>
  <check level="warning" class="org.scalastyle.scalar.PackageObjectNamesChecker" enabled="true">
    <parameters>
      <parameter name="regex"><![CDATA[[a-z][A-Za-z0-9]*]]></parameter>
    </parameters>
  </check>
  <check level="warning" class="org.scalastyle.scalar.MethodNamesChecker" enabled="true">
    <parameters>
      <parameter name="regex"><![CDATA[[a-z][A-Za-z0-9]*]]></parameter>
    </parameters>
  </check>

  <!-- Structural and Best Practices -->
  <check level="error" class="org.scalastyle.scalar.NullChecker" enabled="true"></check>
  <check level="error" class="org.scalastyle.scalar.ReturnChecker" enabled="true"></check>
  <check level="warning" class="org.scalastyle.scalar.NoCloneChecker" enabled="true"></check>
  <check level="warning" class="org.scalastyle.scalar.NoFinalizeChecker" enabled="true"></check>
  <check level="warning" class="org.scalastyle.scalar.CovariantEqualsChecker" enabled="true"></check>
  <check level="warning" class="org.scalastyle.scalar.StructuralTypeChecker" enabled="true"></check>

  <!-- Whitespace and Formatting formatting -->
  <check level="warning" class="org.scalastyle.file.FileTabChecker" enabled="true"></check>
  <check level="warning" class="org.scalastyle.file.WhitespaceEndOfLineChecker" enabled="true"></check>
  <check level="warning" class="org.scalastyle.scalar.EnsureSingleSpaceAfterTokenChecker" enabled="true">
    <parameters>
      <parameter name="tokens">COLON, COMMA</parameter>
    </parameters>
  </check>
  <check level="warning" class="org.scalastyle.scalar.NoWhitespaceBeforeLeftBracketChecker" enabled="true">
    <parameters>
      <parameter name="tokens">LEFT_BRACKET</parameter>
    </parameters>
  </check>

  <!-- Type Safety & Logic -->
  <check level="warning" class="org.scalastyle.scalar.EqualsHashCodeChecker" enabled="true"></check>
  <check level="warning" class="org.scalastyle.scalar.PublicMethodsHaveTypeChecker" enabled="true"></check>
  <check level="warning" class="org.scalastyle.scalar.DeprecatedMethodsChecker" enabled="true"></check>
</scalastyle>

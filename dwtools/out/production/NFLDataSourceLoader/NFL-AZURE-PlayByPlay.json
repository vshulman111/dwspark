{
  "sparkParams":
  {
    "sessionAppName": "Spark Data Source Loader"
  },
  "sourceLoad":
  {
    "logFileDir": "/dw/data/LOGS/sourceLoad/",
    "loadActions":
    [
      {
        "name" : "Load Team file",
        "isActive": false,
        "isDebug" : false,
        "loadControl" :
        {
          "loadControlParquetFileDir" : "/dw/data/CONTROL/"
        },
        "fileSource" :
        {
          "isRemoveDuplicateRows": false,
          "dir": "/dw/data/SOURCES/TeamInfo",
          "namePattern" : "NFL-Teams\\.csv",
          "csv" :
          {
            "hasHeader" : true
          },
          "processedFilesDir": "/dw/data/SOURCES/processed/"
        },
        "fileDestination" :
        {
          "isVersioned" : false,
          "parquet" : {},
          "path" : "/dw/data/STAGING/Team.parquet",
          "previousCopyPath" : "/dw/data/STAGING/Team.prev.parquet"
        },
        "schema" :
        [
          { "colName" : "TeamName","colType" : "String" },
          { "colName" : "SeasonAbbreviation", "colType" : "String" },
          { "colName" : "SeasonYear", "colType" : "Integer" },
          { "colName" : "SeasonTeamName", "colType" : "String" },
          { "colName" : "ActiveSince", "colType" : "Integer" }
        ]
      },
      {
        "name" : "Load Players file",
        "isActive": false,
        "isDebug" : true,
        "loadControl" :
        {
          "loadControlParquetFileDir" : "/dw/data/CONTROL/"
        },
        "fileSource" :
        {
          "isRemoveDuplicateRows": true,
          "dir": "/dw/data/SOURCES/Players",
          "namePattern" : "players_2013-12-12.csv",
          "csv" :
          {
            "hasHeader" : true
          },
          "processedFilesDir": "/dw/data/SOURCES/processed/"
        },
        "fileDestination" :
        {
          "isVersioned" : false,
          "parquet" : {},
          "path" : "/dw/data/STAGING/stgPlayers.parquet",
          "optional-value previousCopyPath" : "/dw/data/STAGING/stgPbp.prev.parquet"
        },
        "schema" :
        [
          { "colName" : "name", "colType" : "String" },
          { "colName" : "first_name", "colType" : "String" },
          { "colName" : "last_name", "colType" : "String" },
          { "colName" : "birth_city", "colType" : "String" },
          { "colName" : "birth_state", "colType" : "String" },
          { "colName" : "birth_country", "colType" : "String" },
          { "colName" : "birth_date", "colType" : "String" },
          { "colName" : "college", "colType" : "String" },
          { "colName" : "draft_team", "colType" : "String" },
          { "colName" : "draft_round", "colType" : "String" },
          { "colName" : "draft_pick", "colType" : "String" },
          { "colName" : "draft_year", "colType" : "Integer" },
          { "colName" : "position", "colType" : "String" },
          { "colName" : "height", "colType" : "String" },
          { "colName" : "weight", "colType" : "Integer" },
          { "colName" : "death_date", "colType" : "String" },
          { "colName" : "death_city", "colType" : "String" },
          { "colName" : "death_state", "colType" : "String" },
          { "colName" : "death_country", "colType" : "String" },
          { "colName" : "year_start", "colType" : "Integer" },
          { "colName" : "year_end", "colType" : "Integer" }
        ]
      },
      {
        "name" : "Load Play-By-Play file",
        "isActive": true,
        "isDebug" : false,
        "loadControl" :
        {
          "loadControlParquetFileDir" : "/dw/data/CONTROL/"
        },
        "fileSource" :
        {
          "dir": "/dw/data/SOURCES/PlayByPlay",
          "namePattern" : "pbp-(?<effectiveDate>(?<year>20[0-9][0-9])).csv",
          "csv" :
          {
            "hasHeader" : true
          },
          "processedFilesDir": "/dw/data/SOURCES/processed/"
        },
        "fileDestination" :
        {
          "parquet" : {},
          "path" : "/dw/data/STAGING/stgPbp.parquet",
          "optional-value previousCopyPath" : "/dw/data/STAGING/stgPbp.prev.parquet"
        },
        "schema" :
        [
          { "colName" : "GameId","colType" : "Integer" },
          { "colName" : "GameDate", "colType" : "Timestamp" },
          { "colName" : "Quarter", "colType" : "Integer" },
          { "colName" : "Minute", "colType" : "Integer" },
          { "colName" : "Second", "colType" : "Integer" },
          { "colName" : "OffenseTeam", "colType" : "String" },
          { "colName" : "DefenseTeam", "colType" : "String" },
          { "colName" : "Down", "colType" : "Integer" },
          { "colName" : "ToGo", "colType" : "Integer" },
          { "colName" : "YardLine", "colType" : "Integer" },
          { "colName" : "_c10", "colType" : "String" },
          { "colName" : "SeriesFirstDown", "colType" : "Integer" },
          { "colName" : "_c12", "colType" : "String" },
          { "colName" : "NextScore", "colType" : "Integer" },
          { "colName" : "Description", "colType" : "String" },
          { "colName" : "TeamWin", "colType" : "String" },
          { "colName" : "_c16", "colType" : "String" },
          { "colName" : "_c17", "colType" : "String" },
          { "colName" : "SeasonYear", "colType" : "Integer" },
          { "colName" : "Yards", "colType" : "Integer" },
          { "colName" : "Formation", "colType" : "String" },
          { "colName" : "PlayType", "colType" : "String" },
          { "colName" : "IsRush", "colType" : "String" },
          { "colName" : "IsPass", "colType" : "String" },
          { "colName" : "IsIncomplete", "colType" : "String" },
          { "colName" : "IsTouchdown", "colType" : "Integer" },
          { "colName" : "PassType", "colType" : "String" },
          { "colName" : "IsSack", "colType" : "String" },
          { "colName" : "IsChallenge", "colType" : "Integer" },
          { "colName" : "IsChallengeReversed", "colType" : "String" },
          { "colName" : "Challenger", "colType" : "Integer" },
          { "colName" : "IsMeasurement", "colType" : "Integer" },
          { "colName" : "IsInterception", "colType" : "Integer" },
          { "colName" : "IsFumble", "colType" : "Integer" },
          { "colName" : "IsPenalty", "colType" : "Integer" },
          { "colName" : "IsTwoPointConversion", "colType" : "Integer" },
          { "colName" : "IsTwoPointConversionSuccessful", "colType" : "Integer" },
          { "colName" : "RushDirection", "colType" : "String" },
          { "colName" : "YardLineFixed", "colType" : "Integer" },
          { "colName" : "YardLineDirection", "colType" : "String" },
          { "colName" : "IsPenaltyAccepted", "colType" : "String" },
          { "colName" : "PenaltyTeam", "colType" : "String" },
          { "colName" : "IsNoPlay", "colType" : "String" },
          { "colName" : "PenaltyType", "colType" : "String" },
          { "colName" : "PenaltyYards", "colType" : "String" }
        ]
      }
    ]
  }
}

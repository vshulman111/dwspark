{
  "sparkParams":
  {
    "sessionAppName": "Spark Data Source Loader"
  },
  "sourceLoad":
  {
    "logFileDir": "s3://etl-dw-bucket/LOGS/sourceLoad/",
    "loadActions":
    [
      {
        "name" : "Load Team file",
        "isActive": true,
        "isDebug" : false,
        "isVersioned" : false,
        "isRemoveDuplicateRows": false,
        "loadControl" :
        {
          "loadControlParquetFileDir" : "s3://etl-dw-bucket/CONTROL/"
        },
        "fileSource" :
        {
          "dir": "s3://etl-dw-bucket/SOURCES/TeamInfo",
          "namePattern" : "NFL-Teams\\.csv",
          "csv" :
          {
            "hasHeader" : true
          },
          "processedFilesDir": "s3://etl-dw-bucket/SOURCES/processed/"
        },
        "fileDestination" :
        {
          "parquet" : {},
          "path" : "s3://etl-dw-bucket/STAGING/Team.parquet",
          "previousCopyPath" : "s3://etl-dw-bucket/STAGING/Team.prev.parquet"
        },
        "schema" :
        [
          { "colName" : "TeamName","colType" : "String" },
          { "colName" : "SeasonAbbreviation", "colType" : "String" },
          { "colName" : "SeasonYear", "colType" : "Integer" },
          { "colName" : "SeasonTeamName", "colType" : "String" },
          { "colName" : "ActiveSince", "colType" : "Integer" }
        ]
      }
    ]
  }
}

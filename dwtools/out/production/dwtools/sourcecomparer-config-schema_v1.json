{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source Comparer Configuration",
  "description": "Defines required fields for the application that uses source loader library. The configuration JSON file can have other fields",
  "type": "object",
  "$defs": {
    "jdbcOptions": {
      "description": "These options are applicable to all JDBC databases - currently sql server and oracle. See https://spark.apache.org/docs/latest/sql-data-sources-jdbc.html for details.",
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "dbtable": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "prepareQuery": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "numPartitions": {
          "type": "number"
        },
        "queryTimeout": {
          "type": "number"
        },
        "fetchsize": {
          "type": "number"
        },
        "pushDownPredicate": {
          "type": "boolean"
        },
        "pushDownAggregate": {
          "type": "boolean"
        },
        "pushDownLimit": {
          "type": "boolean"
        },
        "pushDownOffset": {
          "type": "boolean"
        },
        "pushDownTableSample": {
          "type": "boolean"
        },
        "keytab": {
          "type": "string"
        },
        "principal": {
          "type": "string"
        },
        "refreshKrb5Config": {
          "type": "boolean"
        },
        "preferTimestampNTZ": {
          "type": "boolean"
        },
        "hint": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^_comment": {}
      },
      "required": [
        "url"
      ],
      "unevaluatedProperties": false
    },
    "compareSource": {
      "description": "This a definition that is used for both - left and right - compare sources",
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "file": {
              "type": "object",
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "parquet": {
                      "type": "object",
                      "properties": {
                      }
                    }
                  },
                  "required": [
                    "parquet"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "csv": {
                      "type": "object",
                      "properties": {
                        "mode": {
                          "type": "string"
                        },
                        "header": {
                          "type": "boolean"
                        },
                        "encoding": {
                          "type": "string"
                        },
                        "dateFormat": {
                          "type": "string"
                        },
                        "nullValue": {
                          "type": "string"
                        },
                        "escape": {
                          "type": "string"
                        },
                        "quote": {
                          "type": "string"
                        },
                        "delimiter": {
                          "type": "string"
                        }
                      },
                      "unevaluatedProperties": false
                    }
                  },
                  "required": [
                    "csv"
                  ]
                }
              ],
              "properties": {
                "path": {
                  "type": "string"
                }
              },
              "patternProperties": {
                "^_comment": {}
              },
              "required": [
                "path"
              ],
              "unevaluatedProperties": false
            }
          },
          "required": [
            "file"
          ]
        },
        {
          "type": "object",
          "properties": {
            "dbms": {
              "type": "object",
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "sqlServer": {
                      "$ref": "#/$defs/jdbcOptions",
                      "description": "Options for SQL Server jdbc connection."
                    }
                  },
                  "patternProperties": {
                    "^_comment": {}
                  },
                  "required": [
                    "sqlServer"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "oracle": {
                      "$ref": "#/$defs/jdbcOptions",
                      "description": "Options for Oracle jdbc connection."                    }
                  },
                  "patternProperties": {
                    "^_comment": {}
                  },
                  "required": [
                    "oracle"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "mongoDb": {
                      "type": "object",
                      "description": "Properties for mongoDb can be any of the options supported by MongoDb Spark connector in batch mode except following that are defined in a generic part and is valid for other dbms sources: connection.uri, database, collection. Schema must be defined",
                      "properties": {
                        "database": {
                          "type": "string"
                        },
                        "collection": {
                          "type": "string"
                        },
                        "comment": {
                          "type": "string"
                        },
                        "mode": {
                          "type": "string"
                        },
                        "columnNameOfCorruptRecord": {
                          "type": "string"
                        },
                        "mongoClientFactory": {
                          "type": "string"
                        },
                        "partitioner": {
                          "type": "string"
                        },
                        "sampleSize": {
                          "type": "number"
                        },
                        "sql.inferSchema.mapTypes.enabled": {
                          "type": "boolean"
                        },
                        "sql.inferSchema.mapTypes.minimum.key.size": {
                          "type": "number"
                        },
                        "aggregation.pipeline": {
                          "anyOf": [
                            { "type": "string" },
                            {
                              "type": "array",
                              "items": { "type": "string" }
                            }
                          ]
                        },
                        "aggregation.allowDiskUse": {
                          "type": "boolean"
                        },
                        "outputExtendedJson": {
                          "type": "boolean"
                        }
                      },
                      "patternProperties": {
                        "^partitioner\\.options\\.": { "type": "string" },
                        "^_comment": {}
                      },
                      "unevaluatedProperties": false                          }
                  },
                  "patternProperties": {
                    "^_comment": {}
                  },
                  "required": [
                    "mongoDb"
                  ]
                }
              ],
              "properties": {
                "user": {
                  "type": "string"
                },
                "password": {
                  "type": "string"
                }
              },
              "patternProperties": {
                "^_comment": {}
              },
              "required": [
              ],
              "unevaluatedProperties": false
            }
          },
          "required": [
            "dbms"
          ]
        }
      ],
      "properties": {
        "moniker": {
          "type": "string",
          "description": "A meaningful name to show in compare results."
        },
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "colName": {
                "type": "string"
              },
              "colType": {
                "type": "string"
              },
              "isPartitionColumn": {
                "type": "boolean"
              }
            },
            "patternProperties": {
              "^_comment": {}
            },
            "required": [
              "colName"
            ],
            "unevaluatedProperties": false
          }
        },
        "selectClauseWithFieldsToCompare": {
          "description": "Any valid select statement to be executed on a data frame which is created from reading the Source. If not defined all fields from source will be used",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "pattern":  "^[ \\t]*[Ss][Ee][Ll][Ee][Cc][Tt]",
          "customMessage": {
            "pattern": "The statement must begin with the word 'SELECT'."
          }
        }
      },
      "patternProperties": {
        "^_comment": {}
      },
      "required": [
        "moniker"
      ],
      "unevaluatedProperties": false
    }
  },
  "properties": {
    "sourceCompare": {
      "type": "object",
      "description": "Configuration for source compare",
      "properties": {
        "sourceCompareConfigVersion": {
          "type": "string",
          "description": "version of a source compare json configuration",
          "enum": ["1"]
        },
        "logFileDir": {
          "type": "string",
          "description": "A full path of the directory for log files. Used primarily for development."
        },
        "compareScenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "A name of the load action to differentiate multiple load actions. Names must be unique."
              },
              "isActive": {
                "type": "boolean",
                "description": "If the value of isActive is false, the load action will not be processed."
              },
              "isDebugDwLib": {
                "type": "boolean",
                "description": "If the value is true, there will be some dataframe related output sent to the standard output from the library causing slowdown in job execution."
              },
              "floatCompareThreshold": {
                "type": "number",
                "description": "When comparing two floating point values, they will be considered equal if the absolute value of a difference is less than floatCompareThreshold."
              },
              "maxSameDifferences": {
                "type": "number",
                "description": "When defined, the number of reported differences for each column will not exceed the specified value."
              },
              "compareResult": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "object",
                    "properties": {
                      "dir": {
                        "type": "string"
                      },
                      "csv": {
                        "type": "object",
                        "description": "Properties for csv file can be any of the options except inferSchema.",
                        "properties": {
                          "mode": {
                            "type": "string"
                          },
                          "header": {
                            "type": "boolean"
                          },
                          "encoding": {
                            "type": "string"
                          },
                          "dateFormat": {
                            "type": "string"
                          },
                          "nullValue": {
                            "type": "string"
                          },
                          "escape": {
                            "type": "string"
                          },
                          "quote": {
                            "type": "string"
                          },
                          "delimiter": {
                            "type": "string"
                          }
                        },
                        "unevaluatedProperties": false
                      }
                    },
                    "patternProperties": {
                      "^_comment": {}
                    },
                    "required": [
                      "dir",
                      "csv"
                    ],
                    "unevaluatedProperties": false
                  },
                  "schema": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "colName": {
                          "type": "string"
                        },
                        "isUniqueKey": {
                          "type": "boolean"
                        },
                        "isInclude": {
                          "type": "boolean"
                        }
                      },
                      "patternProperties": {
                        "^_comment": {}
                      },
                      "required": [
                        "colName"
                      ],
                      "unevaluatedProperties": false
                    },

                    "allOf" : [
                      {
                        "contains": {
                          "type": "object",
                          "required": [
                            "isUniqueKey"
                          ],
                          "properties": {
                            "isUniqueKey": {
                              "const": true
                            }
                          }
                        },
                        "minContains": 1,
                        "customMessage": {
                          "contains": "Compare result's schema does not have unique key defined. At least one column must have \"isUniqueKey\" flag set to true, i.e., ... \"isUniqueKey\" : true, ... "
                        }
                      }
                    ],
                    "customMessage": {
                      "minItems": "Compare result's schema does not have any columns defined. It must have at least one column"
                    }
                  }
                },
                "patternProperties": {
                  "^_comment": {}
                },
                "required": [
                  "file",
                  "schema"
                ],
                "unevaluatedProperties": false
              },
              "leftSource": {
                "$ref": "#/$defs/compareSource",
                "description": "First or left source to compare."
              },
              "rightSource": {
                "$ref": "#/$defs/compareSource",
                "description": "Second or right source to compare."
              }
            },
            "patternProperties": {
              "^_comment": {}
            },
            "required": [
              "name",
              "isActive",
              "compareResult",
              "leftSource",
              "rightSource"
            ],
            "unevaluatedProperties": false
          }
        }
      },
      "patternProperties": {
        "^_comment": {}
      },
      "required": [
        "sourceCompareConfigVersion",
        "compareScenarios"
      ],
      "unevaluatedProperties": false
    }
  },
  "required": [
    "sourceCompare"
  ],
  "unevaluatedProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source Comparer Configuration for version numbers",
  "description": "Defines allowed versions for the application that uses source comparer library",
  "type": "object",
  "properties": {
    "sourceCompare": {
      "type": "object",
      "description": "Configuration for source comparer",
      "properties": {
        "sourceCompareConfigVersion": {
          "type": "string",
          "description": "Version of a source compare json configuration",
          "enum": ["1"]
        }
      },
      "patternProperties": {
        "^_comment": {}
      },
      "required": [
        "sourceCompareConfigVersion"
      ],
      "unevaluatedProperties": true
    }
  },
  "required": [
    "sourceCompare"
  ],
  "unevaluatedProperties": true
}

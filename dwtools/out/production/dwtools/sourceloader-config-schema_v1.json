{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source Loader Configuration",
  "description": "Defines required field for source loader application that uses source loader library. The configuration JSON file can have other fields",
  "type": "object",
  "$defs": {
    "jdbcOptions": {
      "description": "These options are applicable to all JDBC databases - currently sql server and oracle. See https://spark.apache.org/docs/latest/sql-data-sources-jdbc.html for details.",
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "dbtable": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "prepareQuery": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "numPartitions": {
          "type": "number"
        },
        "queryTimeout": {
          "type": "number"
        },
        "fetchsize": {
          "type": "number"
        },
        "pushDownPredicate": {
          "type": "boolean"
        },
        "pushDownAggregate": {
          "type": "boolean"
        },
        "pushDownLimit": {
          "type": "boolean"
        },
        "pushDownOffset": {
          "type": "boolean"
        },
        "pushDownTableSample": {
          "type": "boolean"
        },
        "keytab": {
          "type": "string"
        },
        "principal": {
          "type": "string"
        },
        "refreshKrb5Config": {
          "type": "boolean"
        },
        "preferTimestampNTZ": {
          "type": "boolean"
        },
        "hint": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^_comment": {}
      },
      "required": [
        "url"
      ],
      "unevaluatedProperties": false
    }
  },
  "properties": {
    "sourceLoad": {
      "type": "object",
      "description": "Configuration for source loader",
      "properties": {
        "sourceLoadConfigVersion": {
          "type": "string",
          "description": "version of a source load json configuration",
          "enum": [
            "1"
          ]
        },
        "logFileDir": {
          "type": "string",
          "description": "A full path of the directory for log files. Used primarily for development."
        },
        "loadActions": {
          "type": "array",
          "items": {
            "type": "object",
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "fileSource"
                ],
                "properties": {
                  "fileSource": {
                    "type": "object",
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "fileSystemLocation": {
                            "type": "object",
                            "properties": {
                              "dir": {
                                "type": "string"
                              },
                              "namePattern": {
                                "type": "string",
                                "description": "A regular expression of file names to process. The files can have effective date as part of the name. In that case the files are processed in a date ascending order."
                              }
                            },
                            "patternProperties": {
                              "^_comment": {}
                            },
                            "required": [
                              "dir",
                              "namePattern"
                            ],
                            "unevaluatedProperties": false
                          }
                        },
                        "required": [
                          "fileSystemLocation"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "internetLocation": {
                            "type": "object",
                            "properties": {
                              "url": {
                                "type": "string"
                              },
                              "user": {
                                "type": "string"
                              },
                              "password": {
                                "type": "string"
                              },
                              "isDisableSslVerification": {
                                "type": "boolean"
                              }
                            },
                            "patternProperties": {
                              "^_comment": {}
                            },
                            "required": [
                              "url"
                            ],
                            "unevaluatedProperties": false
                          }
                        },
                        "required": [
                          "internetLocation"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "customLocation": {
                            "type": "object",
                            "properties": {
                              "packageName": {
                                "type": "string"
                              },
                              "moduleName": {
                                "type": "string"
                              },
                              "methodName": {
                                "type": "string"
                              },
                              "methodReturns": {
                                "type": "string",
                                "description": "The type of data that the method returns: FilePath - the path of the file, FileData - the string with the file content",
                                "enum": [
                                  "FilePath",
                                  "FileData"
                                ]
                              },
                              "applicationSpecific": {
                                "type": "object",
                                "unevaluatedProperties": true
                              }
                            },
                            "patternProperties": {
                              "^_comment": {}
                            },
                            "required": [
                              "moduleName",
                              "methodName",
                              "methodReturns"
                            ],
                            "unevaluatedProperties": false
                          }
                        },
                        "required": [
                          "customLocation"
                        ]
                      }
                    ],
                    "properties": {
                      "isRemoveDuplicateRows": {
                        "type": "boolean"
                      },
                      "effectiveDate": {
                        "type": "string",
                        "format": "date"
                      },
                      "csv": {
                        "type": "object",
                        "description": "Properties for csv file can be any of the options except inferSchema for Spark csv file processing. Schema must be defined",
                        "properties": {
                          "mode": {
                            "type": "string"
                          },
                          "header": {
                            "type": "boolean"
                          },
                          "encoding": {
                            "type": "string"
                          },
                          "dateFormat": {
                            "type": "string"
                          },
                          "nullValue": {
                            "type": "string"
                          },
                          "escape": {
                            "type": "string"
                          },
                          "quote": {
                            "type": "string"
                          },
                          "delimiter": {
                            "type": "string"
                          }
                        },
                        "unevaluatedProperties": false
                      },
                      "processedFilesDir": {
                        "type": "string"
                      }
                    },
                    "patternProperties": {
                      "^_comment": {}
                    },
                    "required": [
                      "csv",
                      "processedFilesDir"
                    ],
                    "unevaluatedProperties": false
                  }
                },
                "patternProperties": {
                  "^_comment": {}
                }
              },
              {
                "type": "object",
                "required": [
                  "dbmsSource"
                ],
                "properties": {
                  "dbmsSource": {
                    "type": "object",
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "sqlServer": {
                            "$ref": "#/$defs/jdbcOptions",
                            "description": "Options for SQL Server jdbc connection."
                          }
                        },
                        "patternProperties": {
                          "^_comment": {}
                        },
                        "required": [
                          "sqlServer"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "oracle": {
                            "$ref": "#/$defs/jdbcOptions",
                            "description": "Options for Oracle jdbc connection."
                          }
                        },
                        "patternProperties": {
                          "^_comment": {}
                        },
                        "required": [
                          "oracle"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "mongoDb": {
                            "type": "object",
                            "description": "Properties for dbmsSource mongoDb can be any of the options supported by MongoDb Spark connector in batch mode. Schema must be defined",
                            "properties": {
                              "connection.uri": {
                                "type": "string"
                              },
                              "database": {
                                "type": "string"
                              },
                              "collection": {
                                "type": "string"
                              },
                              "comment": {
                                "type": "string"
                              },
                              "mode": {
                                "type": "string"
                              },
                              "columnNameOfCorruptRecord": {
                                "type": "string"
                              },
                              "mongoClientFactory": {
                                "type": "string"
                              },
                              "partitioner": {
                                "type": "string"
                              },
                              "sampleSize": {
                                "type": "number"
                              },
                              "sql.inferSchema.mapTypes.enabled": {
                                "type": "boolean"
                              },
                              "sql.inferSchema.mapTypes.minimum.key.size": {
                                "type": "number"
                              },
                              "aggregation.pipeline": {
                                "anyOf": [
                                  {
                                    "type": "string"
                                  },
                                  {
                                    "type": "array",
                                    "items": {
                                      "type": "string"
                                    }
                                  }
                                ]
                              },
                              "aggregation.allowDiskUse": {
                                "type": "boolean"
                              },
                              "outputExtendedJson": {
                                "type": "boolean"
                              }
                            },
                            "patternProperties": {
                              "^partitioner\\.options\\.": {
                                "type": "string"
                              },
                              "^_comment": {}
                            },
                            "required": [
                              "collection"
                            ],
                            "unevaluatedProperties": false
                          }
                        },
                        "patternProperties": {
                          "^_comment": {}
                        },
                        "required": [
                          "mongoDb"
                        ]
                      }
                    ],
                    "properties": {
                      "isRemoveDuplicateRows": {
                        "type": "boolean"
                      },
                      "effectiveDate": {
                        "type": "string",
                        "format": "date"
                      },
                      "user": {
                        "type": "string"
                      },
                      "password": {
                        "type": "string"
                      },
                      "incrementalLoad": {
                        "type": "object",
                        "description": "TODO - add a check to allow incrementalLoad only when destination is versioned",
                        "properties": {
                          "uniqueKeys": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              }
                            ],
                            "description": "Optional. If not defined the query in the form of a table or aggregation pipeline will be generated programmatically. Table for jdbc sources or aggregation pipeline for MongoDB to select all unique keys. It is needed to delete keys from destination file that are no longer in the source"
                          },
                          "delimForWatermarkColumns": {
                            "type": "string",
                            "pattern": "^[:@#!-]+$",
                            "maxLength": 5
                          }
                        },
                        "required": [
                          "delimForWatermarkColumns"
                        ],
                        "patternProperties": {
                          "^_comment": {}
                        },
                        "unevaluatedProperties": false
                      }
                    },
                    "patternProperties": {
                      "^_comment": {}
                    },
                    "required": [
                    ],
                    "dependentSchemas": {
                      "sqlServer": {
                        "properties": {
                          "incrementalLoad": {
                            "required": ["uniqueKeys"]
                          }
                        },
                        "customMessage": {
                          "required": {
                            "uniqueKeys": "\"uniqueKeys\" attribute is missing. It is required for incremental load for sqlServer"
                          }
                        }
                      },
                      "oracle": {
                        "properties": {
                          "incrementalLoad": {
                            "required": ["uniqueKeys"]
                          }
                        },
                        "customMessage": {
                          "required": {
                            "uniqueKeys": "\"uniqueKeys\" attribute is missing. It is required for incremental load for oracle"
                          }
                        }
                      }
                    },
                    "unevaluatedProperties": false
                  }
                },
                "patternProperties": {
                  "^_comment": {}
                }
              }
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "A name of the load action to differentiate multiple load actions. Names must be unique."
              },
              "isActive": {
                "type": "boolean",
                "description": "If the value of isActive is false, the load action will not be processed."
              },
              "isDebugDwLib": {
                "type": "boolean",
                "description": "If the value is true, there will be some dataframe related output sent to the standard output from the library causing slowdown in job execution."
              },
              "fileLoadControl": {
                "type": "object",
                "description": "When this attribute is defined, the loader will create a file with summary info for each load. The info includes record counts, description of source and destination, and the action timing.",
                "properties": {
                  "parquet": {
                    "type": "object",
                    "description": "File type is parquet for load control."
                  },
                  "dir": {
                    "type": "string",
                    "description": "A directory with the load control file."
                  }
                },
                "patternProperties": {
                  "^_comment": {}
                },
                "required": [
                  "parquet",
                  "dir"
                ],
                "unevaluatedProperties": false
              },
              "fileDestination": {
                "type": "object",
                "properties": {
                  "isVersioned": {
                    "type": "boolean"
                  },
                  "parquet": {
                    "type": "object"
                  },
                  "path": {
                    "type": "string"
                  },
                  "previousCopyPath": {
                    "type": "string"
                  }
                },
                "patternProperties": {
                  "^_comment": {}
                },
                "required": [
                  "parquet",
                  "path"
                ],
                "unevaluatedProperties": false
              },
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "colName": {
                      "type": "string"
                    },
                    "colType": {
                      "type": "string"
                    },
                    "isUniqueKey": {
                      "type": "boolean"
                    },
                    "isPartitionColumn": {
                      "type": "boolean"
                    },
                    "isExcludeFromVersioning": {
                      "type": "boolean"
                    }
                  },
                  "patternProperties": {
                    "^_comment": {}
                  },
                  "required": [
                    "colName","colType"
                  ],
                  "unevaluatedProperties": false
                }
              }
            },
            "patternProperties": {
              "^_comment": {}
            },
            "required": [
              "name",
              "isActive",
              "fileDestination"
            ],
            "if": {
              "required": [
                "fileSource"
              ]
            },
            "then": {
              "description": "'schema' is required for fileSource. 'schema' is only required for dbmsSource if 'isUniqueKey' or 'isPartitionColumn' column properties need to be defined. Otherwise 'schema' can be dropped from a load action",
              "required": [
                "schema"
              ]
            },
            "unevaluatedProperties": false
          }
        }
      },
      "patternProperties": {
        "^_comment": {}
      },
      "required": [
        "sourceLoadConfigVersion",
        "loadActions"
      ],
      "unevaluatedProperties": false
    }
  },
  "required": [
    "sourceLoad"
  ],
  "unevaluatedProperties": true
}
